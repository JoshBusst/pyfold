{
  "name": "pyfold",
  "displayName": "pyFold",
  "description": "A Python extension to easily fold all function or class defiitions.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pyfold.foldDefs",
        "title": "Fold Defs"
      },
      {
        "command": "pyfold.unfoldDefs",
        "title": "Unfold Defs"
      },
      {
        "command": "pyfold.foldClasses",
        "title": "Fold Classes"
      },
      {
        "command": "pyfold.unfoldClasses",
        "title": "Unfold Classes"
      },
      {
        "command": "pyfold.foldAll",
        "title": "Fold All"
      },
      {
        "command": "pyfold.unfoldAll",
        "title": "Unfold All"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
